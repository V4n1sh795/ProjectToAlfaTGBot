# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Базовый URL внешнего API, откуда бот получает все данные
API_BASE_URL=https://api.example.com

# Секрет для проверки подписи JWT (или путь к публичному ключу)
JWT_SECRET=super-secret-key
JWT_ALGORITHM=HS256

# Режим отладки
DEBUG=false
